<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Opt out of the edge-to-edge layout that Android 15 (API 35)
             enforces. Without this, the system status bar overlays the
             WebView and the @capacitor/status-bar plugin cannot push
             the content down. Attribute is only read on API 35+; older
             Androids ignore it silently.

             ⚠ ANDROID 16 IGNORES THIS. Since 4.5.14 the app targets 36,
             and the platform honours the opt-out only for apps targeting
             35 — so on an API 35 device this still works, and on API 36 it
             does nothing. What covers API 36 is
             adjustMarginsForEdgeToEdge: 'force' in capacitor.config.ts,
             which margins the WebView from the real window insets. Do not
             delete this attribute expecting that to change anything on 36,
             and do not delete the config expecting this to cover it. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- The theme the app actually runs under: BridgeActivity.onCreate
         switches to it from the launch theme. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- Dark status/navigation icons, because the app chrome behind
             them is white. "Light" here describes the BACKGROUND, not the
             icons — the icons go dark so they are legible on it.

             Set on the theme rather than left to the runtime call in
             configureNativeChrome(), so it is right from the first frame
             instead of flashing white-on-white until the WebView boots. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Paints the strips the system bars sit over. See app_surface in
             colors.xml — without this, a device in dark mode gets the
             DayNight parent's near-black behind bars whose icons have just
             been told to be dark. -->
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Pre-Android-12: the whole window is the splash bitmap. -->
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ draws the splash itself from these attributes:
             flat brand colour plus the animated keep mark. No
             installSplashScreen() call is needed for the starting
             window — the platform reads the launch theme directly. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_keep_animated</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">500</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>