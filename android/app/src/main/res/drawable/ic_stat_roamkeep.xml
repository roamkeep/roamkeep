<!--
  Status-bar / notification small icon: the Roamkeep mark, in the system's
  colour rather than the brand's.

  Android draws a notification small icon from its ALPHA CHANNEL ONLY and
  tints it itself, so it matches the battery, Wi-Fi and signal icons beside
  it and flips with them between light and dark status bars. Any colour in
  here is discarded — which is why the full-colour launcher icon, used as a
  small icon, rendered as a blank white blob. So the mark is one solid
  fill, and the coral window is punched out as a hole (evenOdd) to keep the
  "lit window" read, the same treatment as ic_launcher_monochrome.

  Geometry matches assets/icon.svg. The 84-unit viewport centred on the
  mark (bounds x 26-74, y 18-88) makes it about 20dp tall on the 24dp grid,
  the standard live area for status-bar icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="84"
    android:viewportHeight="84">
    <group
        android:translateX="-8"
        android:translateY="-11">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M26,18 L35,18 L35,26 L44,26 L44,18 L56,18 L56,26 L65,26 L65,18 L74,18 L74,60 L50,88 L26,60 Z M40,58 L40,44 A10,10 0 0 1 60,44 L60,58 Z" />
    </group>
</vector>
