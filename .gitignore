node_modules/
dist/
site-dist/
landing-dist/
.idea/
*.env
.env.*
*.local

# Firebase / FCM credentials. google-services.json contains the
# project's Android API key (not a secret in the cryptographic sense
# — it ships in every APK — but we keep it out of the repo so each
# developer drops in their own from the Firebase Console). The
# service-account JSON used by the notify-checkin edge function IS
# secret; it must never land in the repo.
android/app/google-services.json
firebase-service-account*.json
supabase/.env*

# Supabase CLI local state — version caches, linked-project marker,
# pooler URL. Per-machine; should not be committed.
supabase/.temp/
supabase/.branches/
deploy.config.json

# Wrangler local build/state cache (relay/)
.wrangler/

# Generated setup QR (contains a project URL + anon key)
setup-qr.png

# The wizard's npm-package copy of its inputs (cli/pack-assets.mjs). Only
# ever exists between prepack and postpack; never committed.
cli/assets/

# Launch spike reports (tools/spike/): a throwaway project's ref and the
# raw API responses. Sent back for review, never committed.
spike-report-*.json

# Setup link + QR written by the provisioning wizard. Public-by-design
# (RLS is the boundary) but it is one family's server address — it has
# no business in a shared repo.
roamkeep-setup-*.txt
roamkeep-setup-*.png

# Play listing graphics, generated by tools/store-assets.js. Build products,
# and screenshots-raw/ may hold device grabs of a real family before they are
# replaced with demo ones.
store/

# Demo-backend credentials written by tools/seed-demo.mjs. The demo project
# holds nothing real and these are handed to Google anyway, but a login is
# still a login — it does not belong in a source-available repo.
roamkeep-demo-*.txt
roamkeep-demo-*.json
